<Window x:Class="Postgirl.Presentation.Views.EditConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="920"
        Height="672"
        MinWidth="700"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}"
        Title="{Binding WindowTitle}">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Save"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click" />

            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />

            <Button Content="Reset"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="16,8"
                    Click="ResetButton_Click" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding WindowTitle}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.TextPrimary}"
                   Margin="0,0,0,16" />

        <Border Background="{StaticResource Brush.SurfaceElevated}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <DockPanel>
                <Grid DockPanel.Dock="Top"
                      Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Name"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1"
                               Text="Description"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2"
                               Text="Value"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,12,0" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Description}"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,12,0" />

                                        <Grid Grid.Column="2"
                                              MinWidth="160">
                                            <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStringValueType}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>

                                            <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center"
                                                     PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                                     DataObject.Pasting="IntegerTextBox_Pasting">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIntegerValueType}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>

                                            <CheckBox IsChecked="{Binding BoolValue}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBooleanValueType}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
