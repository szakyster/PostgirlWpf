<UserControl x:Class="Postgirl.Presentation.Views.RequestDocument.Parts.RequestHeadersView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controls="clr-namespace:Postgirl.Presentation.Controls">
	<UserControl.Resources>
		<Style x:Key="ReadOnlyHeaderValueEditStyle"
		       TargetType="TextBox"
		       BasedOn="{StaticResource HeaderValueEditStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding CanEdit}" Value="False">
					<Setter Property="IsReadOnly" Value="True"/>
					<Setter Property="IsHitTestVisible" Value="False"/>
					<Setter Property="Focusable" Value="False"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="ReadOnlyVariableAwareTextBoxStyle" TargetType="{x:Type controls:VariableAwareTextBox}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding CanEdit}" Value="False">
					<Setter Property="IsReadOnly" Value="True"/>
					<Setter Property="IsHitTestVisible" Value="False"/>
					<Setter Property="Focusable" Value="False"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="NonSelectableHeaderRowStyle" TargetType="DataGridRow">
			<Style.Triggers>
				<DataTrigger Binding="{Binding CanEdit}" Value="False">
					<Setter Property="IsSelected" Value="False"/>
					<Setter Property="IsHitTestVisible" Value="False"/>
					<Setter Property="Focusable" Value="False"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="NonSelectableHeaderCellStyle" TargetType="DataGridCell">
			<Style.Triggers>
				<DataTrigger Binding="{Binding CanEdit}" Value="False">
					<Setter Property="IsSelected" Value="False"/>
					<Setter Property="IsHitTestVisible" Value="False"/>
					<Setter Property="Focusable" Value="False"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ADD HEADER BUTTON -->
		<Button Content="+ Add Header"
		        Command="{Binding AddHeaderCommand}"
		        HorizontalAlignment="Left"
		        Margin="0,0,0,8"/>

		<!-- HEADERS GRID -->
		<DataGrid Grid.Row="1"
		          ItemsSource="{Binding RequestHeaders}"
		          AutoGenerateColumns="False"
		          CanUserAddRows="False"
		          RowStyle="{StaticResource NonSelectableHeaderRowStyle}"
		          CellStyle="{StaticResource NonSelectableHeaderCellStyle}"
		          VerticalScrollBarVisibility="Auto">

			<DataGrid.Columns>

				<!-- ENABLE -->
				<DataGridTemplateColumn Width="40">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<CheckBox IsChecked="{Binding IsEnabled , UpdateSourceTrigger=PropertyChanged}"
							          IsEnabled="{Binding CanEdit}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- KEY -->
				<DataGridTextColumn
					
					Header="Header"
					Binding="{Binding Key}"
					Width="200"
					ElementStyle="{StaticResource HeaderValueTextStyle}"
					EditingElementStyle="{StaticResource ReadOnlyHeaderValueEditStyle}"
					/>

				<!-- VALUE -->
				<DataGridTemplateColumn Header="Value" Width="*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<controls:VariableAwareTextBox
								Text="{Binding Value}"
								IsReadOnly="True"
								IsHitTestVisible="False"
								Background="Transparent"
								BorderThickness="0" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
					<DataGridTemplateColumn.CellEditingTemplate>
						<DataTemplate>
							<controls:VariableAwareTextBox
								Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
								
								Background="Transparent"
								BorderThickness="0" />
						</DataTemplate>
					</DataGridTemplateColumn.CellEditingTemplate>
				</DataGridTemplateColumn>

				<!-- REMOVE -->
				<DataGridTemplateColumn Width="40">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Content="✖"
							        Command="{Binding RemoveCommand}"
							        IsEnabled="{Binding CanEdit}"
							        ToolTip="Remove header"
							        Padding="2"
							        Style="{StaticResource GhostButtonStyle}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

			</DataGrid.Columns>
		</DataGrid>

	</Grid>
</UserControl>