<UserControl x:Class="Postgirl.Presentation.Views.RequestDocument.Parts.RequestParametersView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controls="clr-namespace:Postgirl.Presentation.Controls">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ADD PARAMETER BUTTON -->
		<Button Content="+ Add Parameter"
		        Command="{Binding AddParameterCommand}"
		        HorizontalAlignment="Left"
		        Margin="0,0,0,8"/>

		<!-- PARAMETERS GRID -->
		<DataGrid Grid.Row="1"
		          ItemsSource="{Binding RequestParameters}"
		          AutoGenerateColumns="False"
		          CanUserAddRows="False"
		          VerticalScrollBarVisibility="Auto">

			<DataGrid.Columns>

				<!-- ENABLE -->
				<DataGridTemplateColumn Width="40">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- KEY -->
				<DataGridTextColumn
					Header="Parameter"
					Binding="{Binding Key}"
					Width="200"
					ElementStyle="{StaticResource HeaderValueTextStyle}"
					EditingElementStyle="{StaticResource HeaderValueEditStyle}" />

				<!-- VALUE -->
				<DataGridTemplateColumn Header="Value" Width="*">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<controls:VariableAwareTextBox
								Text="{Binding Value}"
								IsReadOnly="True"
								IsHitTestVisible="False"
								Background="Transparent"
								BorderThickness="0"
								VariableBrushSelector="{Binding DataContext.VariableBrushSelector,
									RelativeSource={RelativeSource AncestorType=UserControl}}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
					<DataGridTemplateColumn.CellEditingTemplate>
						<DataTemplate>
							<controls:VariableAwareTextBox
								Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
								Background="Transparent"
								BorderThickness="0"
								VariableBrushSelector="{Binding DataContext.VariableBrushSelector,
									RelativeSource={RelativeSource AncestorType=UserControl}}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellEditingTemplate>
				</DataGridTemplateColumn>

				<!-- REMOVE -->
				<DataGridTemplateColumn Width="40">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Content="✖"
							        Command="{Binding RemoveCommand}"
							        ToolTip="Remove parameter"
							        Padding="2"
							        Style="{StaticResource GhostButtonStyle}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

			</DataGrid.Columns>
		</DataGrid>

	</Grid>
</UserControl>
