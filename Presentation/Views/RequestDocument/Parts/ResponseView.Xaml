<UserControl x:Class="Postgirl.Presentation.Views.RequestDocument.Parts.ResponseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid Margin="0,10,0,0">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Label Content="Response:"/>
		<TabControl Grid.Row="1">
			<TabItem Header="Body">
				<DockPanel>

					<Button DockPanel.Dock="Top"
							Content="Save"
							Command="{Binding SaveFileCommand}"
							HorizontalAlignment="Left"
							Margin="0,0,0,8"
							Padding="16,6">
							<Button.Style>
								<Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsFileResponse}" Value="True">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
						</Button>

					<TextBox Text="{Binding ResponseBody}"
							 Background="Black"
							 Foreground="LightGreen"
							 FontFamily="Consolas"
							 AcceptsReturn="True"
							 IsReadOnly="True"/>

				</DockPanel>
			</TabItem>
			<TabItem Header="Headers">
				<ListBox ItemsSource="{Binding ResponseHeaders}"
				         FontFamily="Consolas"  />
			</TabItem>
		</TabControl>
	</Grid>

</UserControl>