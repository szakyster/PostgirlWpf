<UserControl x:Class="Postgirl.Presentation.Views.RequestDocument.Parts.RequestLineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Postgirl.Presentation.Controls">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ComboBox Width="100"
                  SelectedItem="{Binding Method}"
                  ItemsSource="{Binding HttpMethods}" />

        <controls:VariableAwareTextBox Grid.Column="1"
                                       Margin="10,0"
                                       Text="{Binding Url}"
                                       VariableBrushSelector="{Binding VariableBrushSelector}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal">

            <Button Width="80"
                    Content="{Binding SendButtonText}"
                    Command="{Binding SendCommand}"
                    Style="{StaticResource AccentButtonStyle}"/>

            <Button Width="60"
                    Content="Save"
                    Command="{Binding SaveRequestCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="3,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>