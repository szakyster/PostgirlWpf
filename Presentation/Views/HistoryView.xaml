<UserControl x:Class="Postgirl.Presentation.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<UserControl.Resources>
		<CollectionViewSource x:Key="GroupedHistoryItems" Source="{Binding HistoryItems}">
			<CollectionViewSource.GroupDescriptions>
				<PropertyGroupDescription PropertyName="ExecutedAtGroup"/>
			</CollectionViewSource.GroupDescriptions>
		</CollectionViewSource>
	</UserControl.Resources>

	<Border Padding="2">
		<StackPanel>

			<ListBox ItemsSource="{Binding Source={StaticResource GroupedHistoryItems}}"
		         SelectedItem="{Binding SelectedHistoryItem}"
		         MouseDoubleClick="OnHistoryDoubleClick" Background="{StaticResource Brush.Surface}">

				<ListBox.GroupStyle>
					<GroupStyle>
						<GroupStyle.HeaderTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Name}"
								           Foreground="{StaticResource Brush.TextPrimary}"
								           FontWeight="SemiBold"
								           Margin="4,10,4,4"/>
							</DataTemplate>
						</GroupStyle.HeaderTemplate>
					</GroupStyle>
				</ListBox.GroupStyle>

				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid Margin="2,3">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="40"/>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="40"/>
								<ColumnDefinition Width="45"/>
							</Grid.ColumnDefinitions>

							<!-- METHOD -->
							<TextBlock Grid.Column="0"
						           Text="{Binding Method}"
						           FontWeight="Bold"/>

							<!-- URL -->
							<TextBlock Grid.Column="1"
									   Text="{Binding Url}"
									   ToolTip="{Binding Url}"
									   TextTrimming="CharacterEllipsis"
									   />

							<!-- STATUS -->
							<TextBlock Grid.Column="2"
						           Text="{Binding StatusCode}"
						           HorizontalAlignment="Center"/>

							<!-- DURATION -->
							<TextBlock Grid.Column="3"
						           Text="{Binding DurationMs, StringFormat='{}{0} ms'}"
						           HorizontalAlignment="Right"/>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>

			</ListBox>
		</StackPanel>
	</Border>
</UserControl>
