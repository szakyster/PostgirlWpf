<UserControl x:Class="Postgirl.Presentation.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Border Padding="2">
		<StackPanel>

			<ListBox ItemsSource="{Binding HistoryItems}"
		         SelectedItem="{Binding SelectedHistoryItem}"
		         MouseDoubleClick="OnHistoryDoubleClick" Background="{StaticResource Brush.Surface}">

				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid Margin="2,3">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="40"/>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="40"/>
								<ColumnDefinition Width="45"/>
							</Grid.ColumnDefinitions>

							<!-- METHOD -->
							<TextBlock Grid.Column="0"
						           Text="{Binding Method}"
						           FontWeight="Bold"/>

							<!-- URL -->
							<TextBlock Grid.Column="1"
									   Text="{Binding Url}"
									   ToolTip="{Binding Url}"
									   TextTrimming="CharacterEllipsis"
									   />

							<!-- STATUS -->
							<TextBlock Grid.Column="2"
						           Text="{Binding StatusCode}"
						           HorizontalAlignment="Center"/>

							<!-- DURATION -->
							<TextBlock Grid.Column="3"
						           Text="{Binding DurationMs, StringFormat='{}{0} ms'}"
						           HorizontalAlignment="Right"/>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>

			</ListBox>
		</StackPanel>
	</Border>
</UserControl>
