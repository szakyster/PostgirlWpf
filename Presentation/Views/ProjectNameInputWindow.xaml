<Window x:Class="Postgirl.Presentation.Views.ProjectNameInputWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Project name"
		Width="400"
		SizeToContent="Height"
		ResizeMode="NoResize"
		WindowStartupLocation="CenterOwner"
		Style="{StaticResource DialogWindowStyle}">

	<StackPanel Margin="24">

		<TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Prompt}"
				   Foreground="{StaticResource Brush.TextPrimary}"
				   FontSize="14"
				   FontWeight="SemiBold"
				   Margin="0,0,0,12"/>

		<TextBox x:Name="NameTextBox"
				 Text=""
				 MaxLength="64"
				 Padding="8,6"
				 Background="{StaticResource Brush.Surface}"
				 Foreground="{StaticResource Brush.TextPrimary}"
				 BorderBrush="{StaticResource Brush.Border}"
				 CaretBrush="{StaticResource Brush.TextPrimary}"
				 Margin="0,0,0,6"
				 KeyDown="NameTextBox_KeyDown"/>

		<TextBlock x:Name="ErrorText"
				   Foreground="{StaticResource Brush.Error}"
				   FontSize="11"
				   Visibility="Collapsed"
				   Margin="0,0,0,12"/>

		<StackPanel Orientation="Horizontal"
					HorizontalAlignment="Right"
					Margin="0,12,0,0">
			<Button Content="OK"
					Style="{StaticResource AccentButtonStyle}"
					Padding="20,8"
					Margin="0,0,8,0"
					Click="OkButton_Click"/>
			<Button Content="Cancel"
					Style="{StaticResource SecondaryButtonStyle}"
					Padding="20,8"
					Click="CancelButton_Click"/>
		</StackPanel>

	</StackPanel>
</Window>
