<Window x:Class="Postgirl.Presentation.Views.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:views="clr-namespace:Postgirl.Presentation.Views"
		Height="750" Width="1024"
		Icon="/Assets/postgirl.ico"
		Background="{StaticResource Brush.Background}">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
	</Window.Resources>

	<Window.Title>
		<MultiBinding StringFormat="Postgirl - {0}">
			<Binding Path="AppVersion"/>
		</MultiBinding>
	</Window.Title>

	<Window.InputBindings>
		<KeyBinding Key="Escape" Command="{Binding ActiveDocument.CancelCommand}"/>
	</Window.InputBindings>

	<DockPanel Background="{StaticResource Brush.Surface}">

		<Border DockPanel.Dock="Top"
		        Background="{StaticResource Brush.SurfaceElevated}"
		        BorderBrush="{StaticResource Brush.Border}"
		        BorderThickness="0,0,0,1">

			<Menu Background="{StaticResource Brush.SurfaceElevated}"
			      Foreground="{StaticResource Brush.TextPrimary}">
				<MenuItem Header="New"
				          Command="{Binding NewTabCommand}" />
				<MenuItem Header="Options"
				          Click="OptionsMenuItem_Click" />
				<MenuItem Header="Exit"
				          Click="ExitMenuItem_Click" />
			</Menu>

		</Border>


		<!-- Main content -->
		<Grid>
			<Grid.ColumnDefinitions>
				<!-- Left sidebar -->
				<ColumnDefinition Width="340" />
				<!-- Main editor -->
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- =====================  -->
			<!-- Left Sidebar           -->
			<!-- ===================== -->

			<Border Grid.Column="0"
					Width="auto"
					Background="{StaticResource Brush.SurfaceElevated}"
					BorderBrush="{StaticResource Brush.Border}"
					BorderThickness="0,0,1,0">

				<DockPanel Background="Transparent">

					<!-- Version info at bottom -->
					<Border DockPanel.Dock="Bottom"
							Background="Transparent"
							Padding="12,8"
							BorderBrush="{StaticResource Brush.Border}"
							BorderThickness="0,1,0,0">
						<TextBlock Text="{Binding AppVersion}"
								   FontSize="10"
								   Foreground="Gray"
								   HorizontalAlignment="Center"/>
					</Border>

					<!-- Content -->
					<ScrollViewer VerticalScrollBarVisibility="Auto"
								  Background="Transparent">

						<StackPanel Margin="8,0,8,6">

							<!-- Saved -->
							<Expander x:Name="SavedExpander"
									  Header="Saved Requests"
									  IsExpanded="True"
									  Expanded="Expander_Expanded"
									  Margin="0,0,0,6">

								<views:SavedRequestsView/>

							</Expander>

							<!-- History -->
							<Expander x:Name="HistoryExpander"
									  Header="History"
									  IsExpanded="False"
									  Expanded="Expander_Expanded"
									  Margin="0,0,0,6">

								<views:HistoryView DataContext="{Binding HistoryViewModel}"/>

							</Expander>

							<!-- Variables -->
								<Expander x:Name="VariablesExpander"
										  Header="Variables"
										  Visibility="{Binding IsVariablesPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
										  IsExpanded="False"
										  Expanded="Expander_Expanded">

									<views:VariablesView DataContext="{Binding VariablesViewModel}"/>

								</Expander>

						</StackPanel>

					</ScrollViewer>

				</DockPanel>

			</Border>


			<!-- ===================== -->
			<!-- Tabs / main content -->
			<!-- ===================== -->
			<TabControl Grid.Column="1"
			            ItemsSource="{Binding Documents}"
		            SelectedItem="{Binding ActiveDocument}">

				<TabControl.ItemTemplate>
					<DataTemplate>
						<DockPanel LastChildFill="False">

							<Button DockPanel.Dock="Right"
						        Content="✕"
						        Width="18"
						        Height="18"
						        Margin="5,0,0,0"
						        Padding="0"
						        Focusable="False"
						        Command="{Binding DataContext.CloseDocumentCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
						        CommandParameter="{Binding}" />

							<TextBlock Text="{Binding Title, Converter={StaticResource StringTruncateConverter}, ConverterParameter=30}"
								   VerticalAlignment="Center"
								   Margin="0,0,5,0" />

						</DockPanel>
					</DataTemplate>
				</TabControl.ItemTemplate>

				<TabControl.ContentTemplate>
					<DataTemplate>
						<views:RequestDocumentView />
					</DataTemplate>
				</TabControl.ContentTemplate>

			</TabControl>
		</Grid>
	</DockPanel>
</Window>