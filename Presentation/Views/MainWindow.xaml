<Window x:Class="Postgirl.Presentation.Views.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:views="clr-namespace:Postgirl.Presentation.Views"
		Height="750" Width="1024"
		Icon="/Assets/postgirl.ico"
		Background="{StaticResource Brush.Background}">

	<Window.Title>
		<MultiBinding StringFormat="Postgirl - {0}">
			<Binding Path="AppVersion"/>
		</MultiBinding>
	</Window.Title>

	<Window.InputBindings>
		<KeyBinding Key="Escape" Command="{Binding ActiveDocument.CancelCommand}"/>
	</Window.InputBindings>

	<DockPanel Background="{StaticResource Brush.Surface}">

		<!-- top bar -->
		<Border DockPanel.Dock="Top"
		        Background="{StaticResource Brush.SurfaceElevated}"
		        BorderBrush="{StaticResource Brush.Border}"
		        BorderThickness="0,0,0,1"
		        Padding="12,8">

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- LEFT ACTIONS -->
				<StackPanel Orientation="Horizontal"
				            VerticalAlignment="Center">

					<Button Content="+ New"
					        Command="{Binding NewTabCommand}"
					        Style="{StaticResource AccentButtonStyle}"
					        Margin="0,0,8,0"
							Padding="10, 0, 10, 0"
					        />

				</StackPanel>

				<!-- CENTER (reserved for future search maybe) -->
				<ContentControl Grid.Column="1"/>

				<!-- RIGHT SIDE (future environment selector) -->
				<StackPanel Grid.Column="2"
				            Orientation="Horizontal"
				            VerticalAlignment="Center">

					<!-- Future: Environment selector -->
					<!-- <ComboBox Width="180"/> -->

				</StackPanel>

			</Grid>

		</Border>


		<!-- Main content -->
		<Grid>
			<Grid.ColumnDefinitions>
				<!-- Left sidebar -->
				<ColumnDefinition Width="340" />
				<!-- Main editor -->
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- =====================  -->
			<!-- Left Sidebar           -->
			<!-- ===================== -->

			<Border Grid.Column="0"
					Width="auto"
					Background="{StaticResource Brush.SurfaceElevated}"
					BorderBrush="{StaticResource Brush.Border}"
					BorderThickness="0,0,1,0">

				<DockPanel Background="Transparent">

					<!-- Version info at bottom -->
					<Border DockPanel.Dock="Bottom"
							Background="Transparent"
							Padding="12,8"
							BorderBrush="{StaticResource Brush.Border}"
							BorderThickness="0,1,0,0">
						<TextBlock Text="{Binding AppVersion}"
								   FontSize="10"
								   Foreground="Gray"
								   HorizontalAlignment="Center"/>
					</Border>

					<!-- Content -->
					<ScrollViewer VerticalScrollBarVisibility="Auto"
								  Background="Transparent">

						<StackPanel Margin="8,0,8,12">

							<!-- Saved -->
							<Expander Header="Saved Requests"
							          IsExpanded="True"
							          Margin="0,0,0,12">

								<views:SavedRequestsView/>

							</Expander>

							<!-- History -->
							<Expander Header="History"
							          IsExpanded="True">

								<views:HistoryView DataContext="{Binding HistoryViewModel}"/>

							</Expander>

						</StackPanel>

					</ScrollViewer>

				</DockPanel>

			</Border>


			<!-- ===================== -->
			<!-- Tabs / main content -->
			<!-- ===================== -->
			<TabControl Grid.Column="1"
			            ItemsSource="{Binding Documents}"
		            SelectedItem="{Binding ActiveDocument}">

				<TabControl.ItemTemplate>
					<DataTemplate>
						<DockPanel LastChildFill="False">

							<Button DockPanel.Dock="Right"
						        Content="✕"
						        Width="18"
						        Height="18"
						        Margin="5,0,0,0"
						        Padding="0"
						        Focusable="False"
						        Command="{Binding DataContext.CloseDocumentCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
						        CommandParameter="{Binding}" />

							<TextBlock Text="{Binding Title}"
						           VerticalAlignment="Center"
						           Margin="0,0,5,0" />

						</DockPanel>
					</DataTemplate>
				</TabControl.ItemTemplate>

				<TabControl.ContentTemplate>
					<DataTemplate>
						<views:RequestDocumentView />
					</DataTemplate>
				</TabControl.ContentTemplate>

			</TabControl>
		</Grid>
	</DockPanel>
</Window>