<UserControl x:Class="Postgirl.Presentation.Views.SavedRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Border Padding="6">
		<StackPanel>

			<ListBox ItemsSource="{Binding SavedRequests}" MouseDoubleClick="OnDoubleClick" Background="{StaticResource Brush.Surface}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border Padding="4">
							<StackPanel>
								<TextBlock Text="{Binding Name}"
								           FontWeight="SemiBold"/>
								<TextBlock Text="{Binding Url}"
								           FontSize="11"
								           Foreground="Gray"
								           TextTrimming="CharacterEllipsis"/>
							</StackPanel>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

		</StackPanel>
	</Border>

</UserControl>