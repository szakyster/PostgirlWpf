<Window x:Class="Postgirl.Presentation.Views.ProjectManagementWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Manage Projects"
		Width="560"
		Height="460"
		MinWidth="420"
		MinHeight="320"
		WindowStartupLocation="CenterOwner"
		Style="{StaticResource DialogWindowStyle}">

	<DockPanel Margin="24">

		<!-- Title -->
		<TextBlock DockPanel.Dock="Top"
				   Text="Manage Projects"
				   FontSize="20"
				   FontWeight="SemiBold"
				   Foreground="{StaticResource Brush.TextPrimary}"
				   Margin="0,0,0,16"/>

		<!-- Bottom buttons -->
		<StackPanel DockPanel.Dock="Bottom"
					Orientation="Horizontal"
					HorizontalAlignment="Left"
					Margin="0,12,0,0">
			<Button Content="+ New Project"
					Style="{StaticResource AccentButtonStyle}"
					Padding="14,7"
					Click="NewProject_Click"/>
		</StackPanel>

		<!-- Project list -->
		<Border Background="{StaticResource Brush.SurfaceElevated}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="1"
				CornerRadius="6">

			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<ItemsControl x:Name="ProjectsList"
							  Margin="4">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Padding="10,8"
									Margin="2"
									CornerRadius="4"
									Background="Transparent">
								<Border.Style>
									<Style TargetType="Border">
										<Style.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
											</Trigger>
										</Style.Triggers>
									</Style>
								</Border.Style>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<!-- Name + default badge -->
									<StackPanel Orientation="Horizontal"
												VerticalAlignment="Center">
										<TextBlock Text="{Binding Name}"
												   Foreground="{StaticResource Brush.TextPrimary}"
												   FontSize="13"
												   VerticalAlignment="Center"/>
										<Border Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}"
												Background="{StaticResource Brush.Accent}"
												CornerRadius="3"
												Padding="5,1"
												Margin="8,0,0,0">
											<TextBlock Text="default"
													   Foreground="White"
													   FontSize="10"/>
										</Border>
									</StackPanel>

									<!-- Actions -->
									<StackPanel Grid.Column="1"
												Orientation="Horizontal">
										<Button Content="Rename"
												Style="{StaticResource SecondaryButtonStyle}"
												Padding="10,4"
												Margin="0,0,4,0"
												IsEnabled="{Binding IsDefault, Converter={StaticResource InverseBoolConverter}}"
												Tag="{Binding}"
												Click="RenameProject_Click"/>
										<Button Content="Duplicate"
												Style="{StaticResource SecondaryButtonStyle}"
												Padding="10,4"
												Margin="0,0,4,0"
												Tag="{Binding}"
												Click="DuplicateProject_Click"/>
										<Button Content="Delete"
												Style="{StaticResource SecondaryButtonStyle}"
												Padding="10,4"
												IsEnabled="{Binding IsDefault, Converter={StaticResource InverseBoolConverter}}"
												Tag="{Binding}"
												Click="DeleteProject_Click"/>
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Border>

	</DockPanel>
</Window>
