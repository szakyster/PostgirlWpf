
<Application x:Class="Postgirl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Postgirl.Converters"
             >
    <Application.Resources>
	    <ResourceDictionary>
			<converters:BodyTypeToVisibilityConverter x:Key="BodyTypeToVisibilityConverter"/>
				<converters:StatusCodeToVisibilityConverter x:Key="StatusCodeToVisibilityConverter" />
				<converters:StringTruncateConverter x:Key="StringTruncateConverter"/>
				<converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
				<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Presentation/Themes/Colors.xaml"/>
				<ResourceDictionary Source="Presentation/Themes/Brushes.xaml"/>
				<ResourceDictionary Source="/Presentation/Themes/HeaderStyles.xaml" />
				<ResourceDictionary Source="Presentation/Themes/Controls.Base.xaml"/>
				<ResourceDictionary Source="Presentation/Themes/Controls.Buttons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
	    </ResourceDictionary>
	</Application.Resources>
</Application>
